# Canvas credentials. `canvas-cli login` is the recommended setup and stores
# these securely; use .env only if you prefer environment-based config.
# When CANVAS_BASE_URL is set here, it is used verbatim (include /api/v1), and
# CANVAS_ACCESS_TOKEN must be set here too — a stored token is never combined
# with an environment URL.
CANVAS_BASE_URL=https://your-school.instructure.com/api/v1
CANVAS_ACCESS_TOKEN=your_access_token_here

# Optional: named profile to use (defaults to "default"; see `canvas-cli login --profile`)
# CANVAS_CLI_PROFILE=school

# AI Provider — configure ONE provider for smart features:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# AI_PROVIDER=google   # or gemini
# GOOGLE_API_KEY=your_google_api_key_here

# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SESSION_TOKEN=your_optional_aws_session_token_here
# AWS_BEARER_TOKEN_BEDROCK=your_optional_bedrock_bearer_token_here

# Subscription providers (no API key). Never auto-detected: set AI_PROVIDER
# explicitly or pick them in `canvas-cli login`. You install the vendor CLI
# yourself; canvas-cli drives it locally and never stores a token for it.

# GitHub Copilot — works with Copilot Free and the free Copilot Pro students
# get through GitHub Education. Setup:
#   npm install -g @github/copilot
#   copilot login
# AI_PROVIDER=copilot

# ChatGPT via the OpenAI Codex CLI (aliases: chatgpt, openai-codex).
# EXPERIMENTAL: OpenAI has not published terms that explicitly cover third-party
# tools using a ChatGPT plan through the Codex CLI. This relies on your own
# local `codex login`; usage counts against your plan. Setup:
#   npm install -g @openai/codex
#   codex login
# AI_PROVIDER=codex

# Optional: override the default model for your provider
# AI_MODEL=claude-opus-5                 # or claude-fable-5-1, claude-sonnet-5, claude-haiku-4-5, ...
# AI_MODEL=gpt-5.6                       # or gpt-5.6-terra, gpt-5.6-luna, gpt-5.5, gpt-6-astra, ...
# AI_MODEL=gemini-3.8-flash              # or gemini-3.1-pro-preview, gemini-3.5-flash-lite, ...
# AI_MODEL=us.anthropic.claude-sonnet-5  # or us.anthropic.claude-opus-5, global.anthropic.claude-fable-5-1, ...
# AI_MODEL=auto      # copilot default (Copilot picks); or any ID the copilot CLI accepts
# AI_MODEL=default   # codex default (your codex config); or any ID the codex CLI accepts

# Optional: thinking effort for every provider (Anthropic, OpenAI, Google, Bedrock, Copilot, Codex).
# One of: low, medium, high, xhigh, max. A level the model does not support rounds up to the nearest one it does.
# AI_EFFORT=medium

# Backward-compatible fallback: if AI_PROVIDER is unset, the app auto-detects
# Anthropic/OpenAI/Google from whichever API key is present first. Bedrock,
# copilot, and codex are never auto-detected.

# Optional: verbose diagnostic logging to stderr (same as the --debug flag; secrets are masked)
# DEBUG=canvas-cli

# Optional: force plaintext-file credential storage instead of the macOS Keychain.
# Mainly for tests and CI; files are written with 0600 permissions under ~/.config/canvas-cli/credentials/
# CANVAS_CLI_CREDENTIAL_BACKEND=file
