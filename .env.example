# Canvas credentials. `canvas-cli login` is the recommended setup and stores
# these securely; use .env only if you prefer environment-based config.
# When CANVAS_BASE_URL is set here, it is used verbatim (include /api/v1), and
# CANVAS_ACCESS_TOKEN must be set here too — a stored token is never combined
# with an environment URL.
CANVAS_BASE_URL=https://your-school.instructure.com/api/v1
CANVAS_ACCESS_TOKEN=your_access_token_here

# Optional: named profile to use (defaults to "default"; see `canvas-cli login --profile`)
# CANVAS_CLI_PROFILE=school

# AI Provider — configure ONE provider for smart features:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# AI_PROVIDER=google   # or gemini
# GOOGLE_API_KEY=your_google_api_key_here

# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SESSION_TOKEN=your_optional_aws_session_token_here
# AWS_BEARER_TOKEN_BEDROCK=your_optional_bedrock_bearer_token_here

# Optional: override the default model for your provider
# AI_MODEL=claude-sonnet-4-6
# AI_MODEL=gpt-5.4
# AI_MODEL=gemini-3.5-flash
# AI_MODEL=us.anthropic.claude-sonnet-4-6

# Optional: thinking effort for Anthropic, OpenAI, and Bedrock (ignored for Google).
# One of: low, medium, high, max
# AI_EFFORT=medium

# Backward-compatible fallback: if AI_PROVIDER is unset, the app auto-detects
# Anthropic/OpenAI/Google from whichever API key is present first.

# Optional: verbose diagnostic logging to stderr (same as the --debug flag; secrets are masked)
# DEBUG=canvas-cli

# Optional: force plaintext-file credential storage instead of the macOS Keychain.
# Mainly for tests and CI; files are written with 0600 permissions under ~/.config/canvas-cli/credentials/
# CANVAS_CLI_CREDENTIAL_BACKEND=file
