{
  "name": "canvas-cli",
  "version": "0.1.0",
  "description": "A terminal interface for Canvas LMS",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "canvas",
    "cli",
    "lms",
    "terminal",
    "typescript"
  ],
  "bin": {
    "canvas-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "ai": "^6.0.141",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pdf-parse": "^1.1.1",
    "yauzl-promise": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
