{
  "name": "@reyabsaluja/canvas-cli",
  "version": "0.1.0",
  "description": "A terminal interface for Canvas LMS",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "repository": {
    "type": "git",
    "url": "https://github.com/reyabsaluja/canvas-cli.git"
  },
  "author": "Reyab Saluja",
  "homepage": "https://github.com/reyabsaluja/canvas-cli#readme",
  "bugs": {
    "url": "https://github.com/reyabsaluja/canvas-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "keywords": [
    "canvas",
    "canvas-lms",
    "cli",
    "lms",
    "terminal",
    "typescript",
    "education",
    "assignments",
    "tui",
    "ai"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "canvas-cli": "./bin/canvas-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "check": "bun run typecheck && bun run test && bun run build",
    "dev": "bun run src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preversion": "bun run check",
    "postversion": "printf '\\nVersion bumped. Push with: git push origin HEAD --follow-tags\\n'",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.96",
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/openai": "^3.0.48",
    "ai": "^6.0.141",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "yauzl-promise": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
